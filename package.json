{
  "name": "smart-notes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm dlx prisma@6.19.0 generate --schema=src/db/schema.prisma && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "pnpm dlx prisma@6.19.0 generate --schema=src/db/schema.prisma",
    "migrate": "pnpm dlx prisma@6.19.0 generate --schema=src/db/schema.prisma && pwsh -NoProfile -Command \"Get-Content .env.local | ForEach-Object { if ($_ -match '^(.*?)=(.*)$') { $key=$matches[1]; $val=$matches[2]; Set-Item -Path Env:$key -Value $val } }; pnpm dlx prisma@6.19.0 migrate dev --name init\""
  },
  "prisma": {
    "schema": "src/db/schema.prisma"
  },
  "pnpm": {
    "overrides": {
      "@tiptap/core": "3.10.2",
      "@tiptap/pm": "3.10.2"
    }
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "@tiptap/core": "3.10.2",
    "@tiptap/extension-image": "3.10.2",
    "@tiptap/extension-link": "3.10.2",
    "@tiptap/extension-placeholder": "3.10.2",
    "@tiptap/extension-text-align": "3.10.2",
    "@tiptap/extension-underline": "3.10.2",
    "@tiptap/pm": "3.10.2",
    "@tiptap/react": "3.10.2",
    "@tiptap/starter-kit": "3.10.2",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.0",
    "fuse.js": "^7.1.0",
    "jsdom": "^27.1.0",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.22",
    "next": "16.0.10",
    "next-themes": "^0.4.6",
    "openai": "^5.23.1",
    "pdf-parse": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-easy-crop": "^5.5.3",
    "react-use-measure": "^2.1.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5"
  }
}
